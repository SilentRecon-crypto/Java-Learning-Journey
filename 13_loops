class Main {
    public static void main(String[] args) {

    // LOOPS
        // there are 3 types of loops in java programming language
                    //  for loop
                    //  while loop 
                    //  do while loop

// print table using a while loop 
        int start = 1;
        int number =  3;
        while (start<=10){
            
            System.out.println(number + "X" + start + "=" + number*start);
            start++;
        }

        
        //  do while loop
        
        // programe to print first 100 natural number using do while loop
        int n = 1;
        do{
            System.out.println(n);
            n++;
        }while(n<=100);


    // for loops
        
        // for(int i =0 ; i<=10;i++){
        //     System.out.println(i);
        // }



        // in reverse order
        for(int i =7 ; i>0;i--){
            System.out.println(i);
        }
        
        }
        
        
        }
}
