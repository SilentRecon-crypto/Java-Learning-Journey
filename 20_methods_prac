        // program to write multipliation table using methods 

class Main {

  static void table(int x){
    for(int i=1 ; i<=10 ; i++){
      System.out.println(x + " X " + i + " = " + x*i);
    }
  }
    public static void main(String[] args) {

      table(5);
        
    }
}

        //program to print a pattern using method

class Main {

  static void pattern(int x){
    for(int i=1 ; i<=x ; i++){
      System.out.println("*".repeat(i));
    }
  }
    
    public static void main(String[] args) {

      pattern(5);
        
    }
}

//program to print sum of first n natural numer using recurssion 

class Main {
    static int sum(int n){
        if(n==1){
            return 1;
        }
        else {
            return n+ sum(n-1);
        }
    }
    public static void main(String[] args) {
        int c = sum(3);
        System.out.println(c);
    }
}
